<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>JauntyQ.Analysis</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>JauntyQ.Analysis</PackageId>
    <Description>Query and migration analysis for JauntyQ: the JNT diagnostics engine, dialect mapping and migration parsing over a jaunty.schema.json snapshot. The generator links this source in; the package exists for the CLI tools that run the same analysis outside the build.</Description>
