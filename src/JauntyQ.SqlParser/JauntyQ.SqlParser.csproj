<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>JauntyQ.SqlParser</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>JauntyQ.SqlParser</PackageId>
