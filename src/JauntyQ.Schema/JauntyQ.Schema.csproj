<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>JauntyQ.Schema</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>JauntyQ.Schema</PackageId>
    <Description>The jaunty.schema.json snapshot model and loader for JauntyQ: tables, columns, indexes, foreign keys, sequences, procedures, functions, enums and user types. Dependency-free apart from System.Text.Json; the generator links this source in, and JauntyQ.Schema.Extraction and JauntyQ.Schema.Contract build on the package.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
