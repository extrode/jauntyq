<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Extrode.JauntyQ.Schema.Extraction</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Extrode.JauntyQ.Schema.Extraction</PackageId>
    <Description>Live schema extraction for JauntyQ: reflect a PostgreSQL, SQL Server, MySQL/MariaDB or SQLite database into the jaunty.schema.json snapshot model. The engine behind `jauntyq schema pull`; carries the ADO.NET providers it needs, which is why it is a separate package from the dependency-free Extrode.JauntyQ.Schema.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Extrode.JauntyQ.Schema\Extrode.JauntyQ.Schema.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Extrode.JauntyQ.Schema.Extraction.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Pin transitive SQLitePCLRaw past CVE-2025-6965 (fixed in 3.0.2+, bundles SQLite 3.50.4.2). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
</Project>
