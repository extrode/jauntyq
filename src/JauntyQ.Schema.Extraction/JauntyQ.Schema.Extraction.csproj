<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JauntyQ.Schema.Extraction</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>JauntyQ.Schema.Extraction</PackageId>
    <Description>Live schema extraction for JauntyQ: reflect a PostgreSQL, SQL Server, MySQL/MariaDB or SQLite database into the jaunty.schema.json snapshot model. The engine behind `jauntyq schema pull`; carries the ADO.NET providers it needs, which is why it is a separate package from the dependency-free JauntyQ.Schema.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JauntyQ.Schema\JauntyQ.Schema.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JauntyQ.Schema.Extraction.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.6" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Pin transitive SQLitePCLRaw past CVE-2025-6965 (fixed in 3.0.2+, bundles SQLite 3.50.4.2). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
</Project>
