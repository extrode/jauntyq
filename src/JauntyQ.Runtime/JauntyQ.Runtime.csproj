<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>JauntyQ.Runtime</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>JauntyQ.Runtime</PackageId>
    <Description>Runtime support for JauntyQ, the compile-time SQL-to-C# source-generator ORM. Intentionally near-empty: generated code carries its own logic.</Description>
  </PropertyGroup>
</Project>
