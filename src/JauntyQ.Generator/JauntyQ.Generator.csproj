<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>JauntyQ.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>JauntyQ.Generator</PackageId>
    <Description>The JauntyQ source generator: validates .sql files against a committed schema snapshot at build time and emits typed, zero-reflection ADO.NET data access. Reference with OutputItemType="Analyzer".</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Pack the build output directly into the Roslyn analyzer path (instead
         of lib/), so consumers pick it up as an analyzer. This also satisfies
         NuGet's "package must have content" check (avoids NU5017) without a
         custom pack target. -->
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <BuildOutputTargetFolder>analyzers/dotnet/cs</BuildOutputTargetFolder>
  </PropertyGroup>
  <!-- Ship the CompilerVisibleProperty registration so consumers' <JauntyQAutoCrud>
       and <JauntyQDialect> reach the generator. NuGet auto-imports
       build/{PackageId}.props into any referencing project. -->
  <ItemGroup>
    <None Include="build\JauntyQ.Generator.props" Pack="true" PackagePath="build\" />
    <None Include="buildTransitive\JauntyQ.Generator.props" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <!-- Global usings for the compile-included JauntyQ.Analysis kernel (the
       generator consumes these primitives; DialectMapper/AutoCrud/UpsertKeyResolver
       live in JauntyQ.Analysis, the migration types in JauntyQ.Analysis.Migrations). -->
  <ItemGroup>
    <Using Include="JauntyQ.Analysis" />
    <Using Include="JauntyQ.Analysis.Migrations" />
    <Using Include="JauntyQ.Analysis.Diff" />
    <Using Include="JauntyQ.Analysis.Impact" />
  </ItemGroup>
  <!-- Compile-include SqlParser, Schema and the shared Analysis kernel for
       generator embedding. The Generator is a Roslyn analyzer, so it embeds the
       source rather than referencing the assemblies. -->
  <ItemGroup>
    <Compile Include="..\JauntyQ.SqlParser\**\*.cs"
             Exclude="..\JauntyQ.SqlParser\obj\**;..\JauntyQ.SqlParser\bin\**"
             Link="Embedded\SqlParser\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\JauntyQ.Schema\**\*.cs"
             Exclude="..\JauntyQ.Schema\obj\**;..\JauntyQ.Schema\bin\**"
             Link="Embedded\Schema\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\JauntyQ.Analysis\**\*.cs"
             Exclude="..\JauntyQ.Analysis\obj\**;..\JauntyQ.Analysis\bin\**"
             Link="Embedded\Analysis\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
