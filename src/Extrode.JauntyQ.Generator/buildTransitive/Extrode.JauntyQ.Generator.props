<Project>
  <!-- buildTransitive twin of build/Extrode.JauntyQ.Generator.props. Imported when the
       package is referenced transitively. The generator is a
       DevelopmentDependency referenced with PrivateAssets="all", so transitive
       flow is normally suppressed; this is kept for correctness if a consumer
       relaxes PrivateAssets. Same content as build/Extrode.JauntyQ.Generator.props. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="JauntyQAutoCrud" />
    <CompilerVisibleProperty Include="JauntyQDialect" />
  </ItemGroup>
</Project>
