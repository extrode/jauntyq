<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Extrode.JauntyQ.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Extrode.JauntyQ.Cli.Core</PackageId>
    <Description>The verb dispatcher, shared plumbing and free verbs behind the jauntyq command-line tool. Extrode.JauntyQ.Cli (free) and Extrode.JauntyQ.Cli.Premium both run their verb lists through CliHost from this library, which is what keeps every free verb identical in the two tools.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Extrode.JauntyQ.Schema\Extrode.JauntyQ.Schema.csproj" />
    <ProjectReference Include="..\Extrode.JauntyQ.SqlParser\Extrode.JauntyQ.SqlParser.csproj" />
    <ProjectReference Include="..\Extrode.JauntyQ.Analysis\Extrode.JauntyQ.Analysis.csproj" />
    <ProjectReference Include="..\Extrode.JauntyQ.Schema.Extraction\Extrode.JauntyQ.Schema.Extraction.csproj" />
  </ItemGroup>
  <!-- CliEnvironment, DialectAliases and PathSafety stay internal: they are
       plumbing the two tools and their tests share, not API a consumer of
       this package is offered. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Extrode.JauntyQ.Cli" />
    <InternalsVisibleTo Include="Extrode.JauntyQ.Cli.Premium" />
    <InternalsVisibleTo Include="Extrode.JauntyQ.Cli.Tests" />
    <InternalsVisibleTo Include="Extrode.JauntyQ.Cli.Premium.Tests" />
  </ItemGroup>
</Project>
