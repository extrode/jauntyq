<Project>
  <!-- Import the repo-root props so shared package/versioning metadata applies
       to src projects (MSBuild stops at the first Directory.Build.props found
       walking up, so it must be imported explicitly). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- src/ product code must stay zero-dependency and NativeAOT/trimming-safe
       (the shipped product carries no dependencies): no LINQ. ImplicitUsings
       silently brings in a global `using System.Linq;`, which is exactly how
       List<T>.Contains(item, IEqualityComparer<T>) has twice quietly bound to
       Enumerable.Contains instead of failing to compile. Removing the global
       using (see src/Directory.Build.targets; it must live there, not here)
       plus a namespace-level analyzer ban below gives two independent,
       build-breaking layers instead of relying on code review to catch it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
