<Project>
  <!-- Import the repo-root props so shared metadata still applies (MSBuild
       stops at the first Directory.Build.props found walking up, so it must
       be imported explicitly — same pattern as src/Directory.Build.props). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Sample apps and live test hosts target net8.0; let them run on
         machines that only have a newer runtime installed (dev machines ahead
         of CI's pinned 8.0.x) instead of aborting with "You must install .NET". -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- Test-only test-infra, scoped to the *.Tests sample suites so the AOT
       smoke app and the plain Extrode.JauntyQ.Sample stay dependency-free. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <!-- Docker/Testcontainers soft-skip -> real xUnit SKIP (see tests/Directory.Build.props). -->
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- Code-coverage collector, same version as tests/Directory.Build.props. Without
         it the sample suites in scripts/coverage.sh's SUITES list run and emit no
         cobertura file at all, so every consumer-side path they exercise — most of
         Extrode.JauntyQ.Runtime — read as uncovered. Inert outside an XPlat Code Coverage run. -->
    <PackageReference Include="coverlet.collector" />
    <!-- Shared CI-strictness gate for Docker-gated fixtures, compiled once per suite. -->
    <Compile Include="$(MSBuildThisFileDirectory)../tests/Shared/FixtureGate.cs" Link="Shared/FixtureGate.cs" />
  </ItemGroup>
</Project>
