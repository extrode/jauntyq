<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Extrode.JauntyQ.Aot.Smoke</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Native AOT + full trim analysis. Even without invoking the native
         linker, the analyzers flag any reflection / trim-unsafe pattern in the
         generated code as a build warning, and TreatWarningsAsErrors (inherited)
         turns that into a hard failure. Proves JauntyQ's emitted code is
         AOT/trim-clean. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Extrode.JauntyQ.Generator\Extrode.JauntyQ.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Extrode.JauntyQ.Runtime\Extrode.JauntyQ.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Use the core provider + the e_sqlite3 bundle so the native SQLite
         library is packaged into the AOT output (the default managed provider
         cannot load it under Native AOT). This is a SQLite-provider packaging
         detail, not a JauntyQ requirement. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <!-- 3.0.3: fixes CVE-2025-6965 (bundles SQLite 3.50.4.2, was flagged at 2.1.10). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="db\**\*.sql" />
    <AdditionalFiles Include="db\schema\*.schema.json" />
  </ItemGroup>
</Project>
