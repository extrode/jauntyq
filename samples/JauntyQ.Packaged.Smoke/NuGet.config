<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
         The clear element below stops this project restoring JauntyQ from a
         machine-level source: a previously published package, or a global
         packages folder entry left by another checkout. The whole point is to
         build against the .nupkg files scripts/packaged-consumer-smoke.sh just
         produced, and a fallback source would let the smoke pass against
         something else entirely.
    -->
    <clear />
    <add key="jauntyq-smoke-feed" value="../../dist/packaged-smoke-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
