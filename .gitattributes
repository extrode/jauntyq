# Normalize line endings in the repository to LF, and check out whatever the
# platform uses. Without this a Windows-authored file arrives on Linux with CRLF
# and reads as a whole-file diff; scripts/repo-split/verify-public-history.sh
# carries a comment about a CRLF checkout silently emptying one of its checks.
* text=auto

# Shell scripts are run by bash on every platform, including Git Bash on
# Windows, and a CR at the end of a shebang or a variable is a syntax error.
*.sh text eol=lf

# Windows-only, and cmd.exe needs the CR.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary, so git must not touch them.
*.png binary
*.ico binary
*.snk binary
*.nupkg binary
*.snupkg binary
