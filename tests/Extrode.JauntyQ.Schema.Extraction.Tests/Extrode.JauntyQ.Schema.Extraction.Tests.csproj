<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Extrode.JauntyQ.Schema.Extraction.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Pin transitive SQLitePCLRaw past CVE-2025-6965 (fixed in 3.0.2+, bundles SQLite 3.50.4.2). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.MariaDb" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Extrode.JauntyQ.Runtime\Extrode.JauntyQ.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Extrode.JauntyQ.Schema\Extrode.JauntyQ.Schema.csproj" />
    <ProjectReference Include="..\..\src\Extrode.JauntyQ.SqlParser\Extrode.JauntyQ.SqlParser.csproj" />
    <ProjectReference Include="..\..\src\Extrode.JauntyQ.Schema.Extraction\Extrode.JauntyQ.Schema.Extraction.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bounds how many Docker containers this assembly holds open at once. It
         owns ~22 Testcontainers fixtures, one container each, and xUnit
         parallelizes collections by default: measured 2026-07-30, running it
         alone peaked at 17 concurrent containers, and a full-solution run
         peaked at 34 on a 16-CPU / 32 GB host. At that level bring-up starts
         losing races, which used to surface as a "Docker unavailable" SKIP and
         a green run that had not run: two runs on the same commit skipped 66
         and 11 of the same 2960 tests. Capping parallel collections at 4 keeps
         the peak in single digits. Not `parallelizeTestCollections: false` as
         the Conduit.SqlServer sibling uses: 22 containers strictly in series
         costs far more wall-clock than the contention is worth, and 4 is
         already well clear of the cliff. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="canonical\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
